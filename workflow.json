{
  "name": "AI Lead Qualification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "name": "Webhook"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a sales lead qualification assistant.\n\nAnalyze this lead:\n\nName: {{ $json.body.name }}\nCompany: {{ $json.body.company }}\nEmail: {{ $json.body.email }}\nRequirement: {{ $json.body.requirement }}\nBudget: {{ $json.body.budget }}\nTimeline: {{ $json.body.timeline }}\n\nRules:\n- lead_score must be a number from 0 to 100.\n- priority must be exactly one of: HOT, WARM, COLD.\n- HOT = 80-100.\n- WARM = 50-79.\n- COLD = 0-49.\n- Do not assume or change the currency.\n- Do not invent information.\n- Keep answers concise.\n\nReturn exactly these fields:\nlead_score\npriority\nbuying_intent\nreason\nrecommended_action\nfollow_up_message",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [400, -32],
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-20b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [400, 144],
      "name": "Groq Chat Model"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"lead_score\": {\n      \"type\": \"number\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"HOT\", \"WARM\", \"COLD\"]\n    },\n    \"buying_intent\": {\n      \"type\": \"string\"\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    },\n    \"recommended_action\": {\n      \"type\": \"string\"\n    },\n    \"follow_up_message\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"lead_score\",\n    \"priority\",\n    \"buying_intent\",\n    \"reason\",\n    \"recommended_action\",\n    \"follow_up_message\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [544, 144],
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Buying Intent": "={{ $json.output.buying_intent }}",
            "Reason": "={{ $json.output.reason }}",
            "Recommended Action": "={{ $json.output.recommended_action }}",
            "Follow-up Message": "={{ $json.output.follow_up_message }}",
            "Priority": "={{ $json.output.priority }}",
            "Lead Score": "={{ $json.output.lead_score }}",
            "Name": "={{ $('Webhook').item.json.body.name }}",
            "Company": "={{ $('Webhook').item.json.body.company }}",
            "Email": "={{ $('Webhook').item.json.body.email }}",
            "Requirement": "={{ $('Webhook').item.json.body.requirement }}",
            "Budget": "={{ $('Webhook').item.json.body.budget.replace('₹', '') }}",
            "Timeline": "={{ $('Webhook').item.json.body.timeline }}"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [176, 80],
      "name": "Append row in sheet"
    }
  ],
  "pinData": {},
  "connections": {
    "Groq Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Basic LLM Chain",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Structured Output Parser": {
      "ai_outputParser": [
        [
          {
            "node": "Basic LLM Chain",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "Webhook": {
      "main": [
        [
          {
            "node": "Basic LLM Chain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Basic LLM Chain": {
      "main": [
        [
          {
            "node": "Append row in sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
  "tags": []
}